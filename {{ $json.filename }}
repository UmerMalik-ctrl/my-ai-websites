<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ahil Milk Farm | Rawalpindi's Purest Dairy</title>
    
    <!-- External Libraries -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

    <style>
        :root {
            --emerald: #064e3b;
            --ivory: #FDFBF7;
            --amber: #d97706;
            --text-dark: #1a2e2a;
        }

        body {
            background-color: var(--ivory);
            color: var(--text-dark);
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }

        .serif { font-family: 'Instrument Serif', serif; }

        /* GSAP Initial States */
        .reveal { opacity: 0; transform: translateY(40px); }

        #hero-three-canvas {
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.3;
        }

        .product-card {
            transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
            border: 1px solid rgba(6, 78, 59, 0.05);
        }

        .product-card:hover {
            transform: translateY(-12px);
            border-color: var(--amber);
            box-shadow: 0 30px 60px rgba(6, 78, 59, 0.1);
        }

        .cart-drawer {
            transition: transform 0.6s cubic-bezier(0.85, 0, 0.15, 1);
            z-index: 100;
        }

        .cart-overlay {
            background: rgba(6, 78, 59, 0.5);
            backdrop-filter: blur(8px);
            z-index: 90;
        }

        .nav-glass {
            backdrop-filter: blur(15px);
            background: rgba(253, 251, 247, 0.85);
        }

        input, select {
            border-bottom: 2px solid rgba(6, 78, 59, 0.1);
            transition: border-color 0.3s ease;
        }

        input:focus, select:focus {
            outline: none;
            border-color: var(--amber);
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        const App = () => {
            const [cart, setCart] = useState([]);
            const [isCartOpen, setIsCartOpen] = useState(false);
            const [deliveryNote, setDeliveryNote] = useState("");
            const [itemQuantities, setItemQuantities] = useState({ 1: 1, 2: 1 });

            const productData = [
                {
                    id: 1,
                    name: "Ahil Pure Whole Milk",
                    price: 245,
                    unit: "Litre",
                    tag: "Morning Fresh",
                    desc: "Unadulterated, farm-fresh milk with 4.5%+ fat content. No preservatives, no hormones.",
                    img: "https://images.unsplash.com/photo-1550583724-1255818c0533?auto=format&fit=crop&q=80&w=800"
                },
                {
                    id: 2,
                    name: "Ahil Premium Desi Ghee",
                    price: 3950,
                    unit: "1KG Jar",
                    tag: "Slow-Cooked",
                    desc: "Traditional Bilona-style ghee made from curd. Golden, granular, and aromatic.",
                    img: "https://images.unsplash.com/photo-1589927986089-35812388d1f4?auto=format&fit=crop&q=80&w=800"
                }
            ];

            const rawalpindiAreas = ["Bahria Town", "DHA Rawalpindi", "Gulraiz", "Westridge", "Saddar", "Satellite Town", "Media Town", "Adyala Road"];

            useEffect(() => {
                // Initialize GSAP ScrollTrigger
                gsap.registerPlugin(ScrollTrigger);
                
                gsap.to(".reveal", {
                    opacity: 1,
                    y: 0,
                    duration: 1.2,
                    stagger: 0.3,
                    ease: "power4.out",
                    scrollTrigger: {
                        trigger: ".reveal",
                        start: "top 90%"
                    }
                });

                // Initialize Three.js Hero Accent
                const scene = new THREE.Scene();
                const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
                const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
                const container = document.getElementById('hero-three-canvas');
                
                if (container) {
                    renderer.setSize(container.offsetWidth, container.offsetHeight);
                    container.appendChild(renderer.domElement);

                    const geometry = new THREE.IcosahedronGeometry(2, 1);
                    const material = new THREE.MeshBasicMaterial({ color: 0x064e3b, wireframe: true, transparent: true, opacity: 0.15 });
                    const orb = new THREE.Mesh(geometry, material);
                    scene.add(orb);

                    camera.position.z = 5;

                    const animate = () => {
                        requestAnimationFrame(animate);
                        orb.rotation.x += 0.002;
                        orb.rotation.y += 0.002;
                        renderer.render(scene, camera);
                    };
                    animate();
                }
            }, []);

            const addToCart = (product) => {
                const qty = itemQuantities[product.id];
                const existingItem = cart.find(i => i.id === product.id);
                if (existingItem) {
                    setCart(cart.map(i => i.id === product.id ? { ...i, qty: i.qty + qty } : i));
                } else {
                    setCart([...cart, { ...product, qty }]);
                }
                setIsCartOpen(true);
            };

            const updateQty = (id, delta) => {
                setItemQuantities(prev => ({ ...prev, [id]: Math.max(1, prev[id] + delta) }));
            };

            const cartTotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            return (
                <div className="min-h-screen">
                    {/* Navigation */}
                    <nav className="nav-glass fixed top-0 w-full z-50 border-b border-emerald/5 px-6 md:px-12 py-5 flex justify-between items-center">
                        <div className="flex items-center gap-3">
                            <div className="w-10 h-10 bg-emerald rounded-lg flex items-center justify-center text-ivory font-black text-xl">A</div>
                            <span className="text-xl font-black tracking-tighter text-emerald uppercase hidden sm:block">Ahil Milk Farm</span>
                        </div>
                        
                        <div className="hidden lg:flex gap-10 font-bold text-xs uppercase tracking-[0.2em] text-emerald">
                            <a href="#" className="hover:text-amber transition-colors">Home</a>
                            <a href="#store" className="hover:text-amber transition-colors">Store</a>
                            <a href="#purity" className="hover:text-amber transition-colors">Purity</a>
                            <a href="#contact" className="hover:text-amber transition-colors">Contact</a>
                        </div>

                        <button onClick={() => setIsCartOpen(true)} className="relative bg-emerald text-ivory p-3 rounded-full hover:bg-amber transition-all hover:scale-110 shadow-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.1-5.38a.5.5 0 0 0-.49-.62H7.64"/></svg>
                            {cart.length > 0 && <span className="absolute -top-1 -right-1 bg-amber text-ivory text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-ivory">{cart.length}</span>}
                        </button>
                    </nav>

                    {/* Hero Section */}
                    <section className="relative h-screen flex items-center overflow-hidden px-6 md:px-12">
                        <div id="hero-three-canvas"></div>
                        <div className="container mx-auto relative z-10">
                            <div className="max-w-4xl">
                                <span className="reveal text-amber font-black tracking-[0.3em] uppercase text-xs mb-4 block">Farm to Table • Rawalpindi</span>
                                <h1 className="reveal serif text-6xl md:text-9xl leading-[0.9] text-emerald mb-8">
                                    Pure Milk. <br/><span className="text-amber italic">Ancient Ghee.</span>
                                </h1>
                                <p className="reveal text-lg md:text-xl text-emerald/80 max-w-xl mb-10 leading-relaxed font-medium" style={{opacity: 0.85}}>
                                    100% natural, hygienic, and unadulterated dairy delivered directly from our farm to your family. Experience the true taste of purity.
                                </p>
                                <div className="reveal flex flex-wrap gap-5">
                                    <a href="#store" className="bg-amber text-ivory px-10 py-5 rounded-full font-black uppercase tracking-widest text-xs hover:bg-emerald transition-all shadow-xl shadow-amber/20">Shop Our Store</a>
                                    <a href="#purity" className="border-2 border-emerald text-emerald px-10 py-5 rounded-full font-black uppercase tracking-widest text-xs hover:bg-emerald hover:text-ivory transition-all">Explore Our Farm</a>
                                </div>
                            </div>
                        </div>
                    </section>

                    {/* Quality Grid */}
                    <section id="purity" className="py-32 bg-emerald text-ivory px-6">
                        <div className="container mx-auto grid lg:grid-cols-3 gap-16">
                            <div className="reveal">
                                <div className="w-16 h-1 bg-amber mb-6"></div>
                                <h3 className="serif text-4xl mb-4">100% Pure & Organic</h3>
                                <p className="text-ivory/70 leading-relaxed text-lg" style={{opacity: 0.8}}>No chemicals, no preservatives, and zero hormones. Our milk is tested daily for purity standards.</p>
                            </div>
                            <div className="reveal">
                                <div className="w-16 h-1 bg-amber mb-6"></div>
                                <h3 className="serif text-4xl mb-4">Hygienic Milking</h3>
                                <p className="text-ivory/70 leading-relaxed text-lg" style={{opacity: 0.8}}>Produced under strict quality controls with zero human touch. Chilled immediately to lock in freshness.</p>
                            </div>
                            <div className="reveal">
                                <div className="w-16 h-1 bg-amber mb-6"></div>
                                <h3 className="serif text-4xl mb-4">Traditional Bilona</h3>
                                <p className="text-ivory/70 leading-relaxed text-lg" style={{opacity: 0.8}}>Our Desi Ghee is made using traditional slow-cooking methods for that authentic granular texture and nutty aroma.</p>
                            </div>
                        </div>
                    </section>

                    {/* Ecommerce Section */}
                    <section id="store" className="py-32 px-6 md:px-12">
                        <div className="container mx-auto">
                            <div className="flex flex-col lg:flex-row justify-between items-end mb-20">
                                <div>
                                    <h2 className="serif text-5xl md:text-8xl text-emerald mb-6 reveal">Farm Fresh Essentials</h2>
                                    <p className="text-emerald/50 font-bold uppercase tracking-widest text-xs reveal" style={{opacity: 0.8}}>Fresh batch available for delivery today</p>
                                </div>
                                
                                <div className="reveal mt-10 lg:mt-0 w-full lg:w-72">
                                    <label className="block text-[10px] font-black uppercase tracking-widest text-amber mb-3">Delivery Check</label>
                                    <select 
                                        className="w-full bg-transparent py-3 font-bold text-emerald"
                                        onChange={(e) => setDeliveryNote(e.target.value ? `✅ Delivered daily to ${e.target.value}` : "")}
                                    >
                                        <option value="">Select Rawalpindi Area</option>
                                        {rawalpindiAreas.map(a => <option key={a} value={a}>{a}</option>)}
                                    </select>
                                    <p className="text-xs font-black text-emerald mt-3">{deliveryNote}</p>
                                </div>
                            </div>

                            <div className="grid md:grid-cols-2 gap-10">
                                {productData.map(p => (
                                    <div key={p.id} className="product-card bg-white rounded-3xl overflow-hidden flex flex-col xl:flex-row reveal">
                                        <div className="xl:w-1/2 h-80 xl:h-auto overflow-hidden">
                                            <img src={p.img} alt={p.name} className="w-full h-full object-cover transform hover:scale-110 transition-transform duration-1000" />
                                        </div>
                                        <div className="p-10 xl:w-1/2 flex flex-col justify-between">
                                            <div>
                                                <span className="text-amber font-black text-[10px] uppercase tracking-widest bg-amber/5 px-3 py-1 rounded-full">{p.tag}</span>
                                                <h3 className="serif text-4xl text-emerald my-4">{p.name}</h3>
                                                <p className="text-emerald/60 text-sm leading-relaxed mb-6" style={{opacity: 0.85}}>{p.desc}</p>
                                                <div className="text-3xl font-black text-emerald">Rs. {p.price} <span className="text-sm font-normal text-emerald/40 tracking-normal">/ {p.unit}</span></div>
                                            </div>
                                            
                                            <div className="flex items-center gap-4 mt-8">
                                                <div className="flex items-center border-2 border-emerald/5 rounded-full px-4 py-2">
                                                    <button onClick={() => updateQty(p.id, -1)} className="text-emerald font-black text-xl hover:text-amber">-</button>
                                                    <span className="mx-6 font-black text-emerald">{itemQuantities[p.id]}</span>
                                                    <button onClick={() => updateQty(p.id, 1)} className="text-emerald font-black text-xl hover:text-amber">+</button>
                                                </div>
                                                <button 
                                                    onClick={() => addToCart(p)}
                                                    className="flex-1 bg-emerald text-ivory py-4 rounded-full font-black uppercase tracking-widest text-xs hover:bg-amber transition-all"
                                                >
                                                    Add To Cart
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </section>

                    {/* Cart Drawer Overlay */}
                    {isCartOpen && <div className="cart-overlay fixed inset-0" onClick={() => setIsCartOpen(false)}></div>}
                    
                    {/* Cart Drawer */}
                    <div className={`cart-drawer fixed top-0 right-0 h-full w-full md:w-[500px] bg-ivory shadow-2xl p-10 flex flex-col transform ${isCartOpen ? 'translate-x-0' : 'translate-x-full'}`}>
                        <div className="flex justify-between items-center mb-12">
                            <h2 className="serif text-5xl text-emerald">Your Cart</h2>
                            <button onClick={() => setIsCartOpen(false)} className="text-emerald hover:text-amber transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                            </button>
                        </div>

                        <div className="flex-1 overflow-y-auto">
                            {cart.length === 0 ? (
                                <div className="text-center py-20">
                                    <p className="text-emerald/30 font-black uppercase tracking-widest text-xs">Your basket is currently empty</p>
                                </div>
                            ) : (
                                cart.map(item => (
                                    <div key={item.id} className="flex gap-6 mb-8 pb-8 border-b border-emerald/5">
                                        <div className="w-24 h-24 rounded-2xl overflow-hidden shrink-0">
                                            <img src={item.img} className="w-full h-full object-cover" />
                                        </div>
                                        <div className="flex-1">
                                            <div className="flex justify-between font-black text-emerald mb-1">
                                                <span>{item.name}</span>
                                                <button onClick={() => setCart(cart.filter(c => c.id !== item.id))} className="text-amber text-[10px] uppercase">Remove</button>
                                            </div>
                                            <div className="text-sm text-emerald/50 mb-3">{item.qty} x Rs. {item.price}</div>
                                            <div className="text-xl font-black text-emerald">Rs. {item.qty * item.price}</div>
                                        </div>
                                    </div>
                                ))
                            )}
                        </div>

                        <div className="mt-auto border-t-4 border-emerald pt-10">
                            <div className="flex justify-between text-3xl font-black text-emerald mb-8">
                                <span>Subtotal</span>
                                <span>Rs. {cartTotal}</span>
                            </div>
                            <button 
                                className="w-full bg-emerald text-ivory py-6 rounded-full font-black uppercase tracking-widest text-sm hover:bg-amber transition-all shadow-2xl shadow-emerald/20 disabled:opacity-30"
                                disabled={cart.length === 0}
                                onClick={() => alert("Redirecting to our secure Rawalpindi checkout portal...")}
                            >
                                Proceed To Checkout
                            </button>
                        </div>
                    </div>

                    {/* Footer */}
                    <footer id="contact" className="py-32 bg-ivory border-t border-emerald/5 px-6 md:px-12">
                        <div className="container mx-auto grid lg:grid-cols-4 gap-16">
                            <div className="lg:col-span-2">
                                <div className="flex items-center gap-3 mb-8">
                                    <div className="w-12 h-12 bg-emerald rounded-lg flex items-center justify-center text-ivory font-black text-2xl">A</div>
                                    <span className="text-2xl font-black tracking-tighter text-emerald uppercase">Ahil Milk Farm</span>
                                </div>
                                <p className="text-emerald/60 text-lg max-w-md mb-10 leading-relaxed font-medium" style={{opacity: 0.8}}>Purity you can trust. Farm-fresh milk and premium desi ghee produced under international hygiene standards, delivered across Rawalpindi.</p>
                                <div className="flex gap-6">
                                    <div className="w-12 h-12 border-2 border-emerald/10 rounded-full flex items-center justify-center hover:bg-emerald hover:text-ivory transition-all cursor-pointer">FB</div>
                                    <div className="w-12 h-12 border-2 border-emerald/10 rounded-full flex items-center justify-center hover:bg-emerald hover:text-ivory transition-all cursor-pointer">IG</div>
                                    <div className="w-12 h-12 border-2 border-emerald/10 rounded-full flex items-center justify-center hover:bg-emerald hover:text-ivory transition-all cursor-pointer">WA</div>
                                </div>
                            </div>
                            <div>
                                <h4 className="font-black text-[10px] uppercase tracking-widest text-amber mb-8">Visit Our Farm</h4>
                                <p className="text-emerald font-bold mb-2">Main Adyala Road, Farm Sector</p>
                                <p className="text-emerald/70 text-sm">Rawalpindi, Pakistan</p>
                                <p className="text-emerald font-black mt-6">051-555-AHIL</p>
                            </div>
                            <div>
                                <h4 className="font-black text-[10px] uppercase tracking-widest text-amber mb-8">Get In Touch</h4>
                                <input type="email" placeholder="Your Email" className="w-full bg-transparent py-4 mb-4 text-emerald font-bold" />
                                <button className="text-emerald font-black text-[10px] uppercase tracking-widest hover:text-amber transition-colors">Send Message</button>
                            </div>
                        </div>
                        <div className="container mx-auto mt-32 pt-10 border-t border-emerald/5 text-center text-[10px] font-black text-emerald/20 uppercase tracking-widest">
                            &copy; 2024 Ahil Milk Farm Rawalpindi • Organic Excellence
                        </div>
                    </footer>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>

    <!-- Babel Transpiler -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</body>
</html>